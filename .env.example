# ==============================================================================
# VISITING CARD SCANNER - ENVIRONMENT CONFIGURATION EXAMPLE
# ==============================================================================
# Copy this file to .env or configure your environment variables:
#
# 1. Groq Cloud LPU API (for high-speed business card NLP extraction)
#    Get your free key at: https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=your_groq_api_key_here

# 2. Free OCR.space API (for cloud OCR fallback in Expo Go)
#    Get your free key at: https://ocr.space/ocrapi/freekey
EXPO_PUBLIC_OCR_KEY=your_ocr_space_api_key_here

# 3. Supabase Cloud PostgreSQL (for cross-device visiting card sync)
#    Get credentials at: https://supabase.com/dashboard
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_supabase_anon_key_here
